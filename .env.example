PUBLIC_BASE_URL=http://localhost:5000
API_KEYS=

HF_CACHE_DIR=~/.cache/huggingface
AUDIOLDM_CACHE_DIR=~/.cache/audioldm
AUDIOLDM_MODEL="audio_generator_model_name"
TRANSLATION_MODEL="translation_model_name"
PROMPT_SUFFIX="realistic high-quality field recording, clear isolated foreground sound"
PUBLIC_BASE_URL=http://localhost:5000

HOST=127.0.0.1
PORT=5000

LOG_LEVEL=INFO
OUTPUT_DIR=outputs
OUTPUT_RETENTION_HOURS=24

ENABLE_TRANSLATION=true
ENABLE_LANGUAGE_DETECTION=true
DETECTION_LANGUAGES="id,en,jv,su,ms,[other language codes]"
LANGUAGE_DETECTION_BACKEND=lingua
DEFAULT_SOURCE_LANGUAGE=eng_Latn
LANGUAGE_DETECTION_MIN_CONFIDENCE=0.55

JOB_RETENTION_MINUTES=60
OUTPUT_RETENTION_HOURS=24

CORS_ORIGINS=*